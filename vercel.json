{
  "redirects": [
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/policy", "destination": "/policy.html" },
    { "source": "/privacy", "destination": "/policy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/plans", "destination": "/pricing.html" },
    { "source": "/refund", "destination": "/refund.html" },
    { "source": "/user-guide", "destination": "/user-guide.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/affiliate-terms", "destination": "/affiliate-terms.html" },
    { "source": "/copyright", "destination": "/copyright.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/track/:code", "destination": "/track.html" },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
